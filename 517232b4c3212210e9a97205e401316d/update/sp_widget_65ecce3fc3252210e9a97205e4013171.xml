        <client_script><![CDATA[api.controller = function() {
  var c = this;
  c.currentIndex = 0;

  c.next = function() {
    c.currentIndex = (c.currentIndex + 1) % c.data.images.length;
  };

  c.prev = function() {
    c.currentIndex = (c.currentIndex - 1 + c.data.images.length) % c.data.images.length;
  };

  setInterval(function() {
    c.next();
  }, 5000);
};]]></client_script>
        <controller_as>c</controller_as>
